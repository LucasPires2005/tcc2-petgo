# Copie para app/.env.local somente ao testar com backend local.
# Use a mesma URL HTTPS temporária de PUBLIC_API_URL no backend.
# Nunca coloque tokens ou chaves secretas em variáveis EXPO_PUBLIC_.
EXPO_PUBLIC_API_URL=https://SUBSTITUA.trycloudflare.com

# Piloto opcional. Sem a flag true, o login por e-mail/senha permanece igual.
# Estas duas configurações são públicas. Use apenas a Publishable Key (sb_publishable_...).
# NUNCA coloque Secret Key, service_role, chave HMAC ou segredo Google no aplicativo.
EXPO_PUBLIC_GOOGLE_LOGIN_ENABLED=false
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# Callback permitido no Supabase: petgo://auth/social-callback
# Google OAuth real exige development build/APK: não funciona no Expo Go.
