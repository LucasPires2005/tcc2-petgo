# Copie para server/.env e preencha somente no seu computador.
# Use conta PetGo de teste: o banco continua sendo o indicado em DATABASE_URL.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
MOBILE_JWT_SECRET=
# Nova base de elegibilidade: chave independente, aleatória, Base64 (32 bytes ou mais).
# Cadastro, declaração e resgate exigem a chave; login e mapa não dependem dela.
CPF_HMAC_SECRET=
# Piloto Google: somente ativar apos SQL 012 e configurar o provedor no Supabase.
# Desativado por padrao; nao altera o login tradicional.
SOCIAL_GOOGLE_ENABLED=false
# Mantenha as credenciais do vendedor de TESTE da integração Sandbox existente.
MERCADO_PAGO_ACCESS_TOKEN=
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
PORT=3000
# Para checkout local: URL HTTPS do túnel que encaminha para localhost:3000.
PUBLIC_API_URL=https://SUBSTITUA.trycloudflare.com
